# Phoebus credentials -- COPY to secrets/phoebus.env and fill in real values.
# secrets/phoebus.env is gitignored; this .example is the committed template.
#
# provision-secrets.sh reads these to stamp a built rootfs tree.

# Wi-Fi passphrase for BOTH radios (Phoebus5 + Phoebus2.4).
# 8..63 printable ASCII. Avoid  |  &  \  (the provisioner uses sed).
WIFI_PASSPHRASE=change-me-to-a-strong-passphrase

# Admin SSH password. Either give ADMIN_PASSWORD (hashed at build with
# `openssl passwd -6`) OR precompute ADMIN_HASH and leave ADMIN_PASSWORD blank.
ADMIN_PASSWORD=change-me-too
# ADMIN_HASH=$6$....           # optional: a crypt(3) string, used verbatim
