# Downloaded / generated — never committed
/toolchain/
rootfs/.work/
rootfs/rootfs-tree/

# Built tool binaries (source is tracked; rebuild via each tool's Makefile)
tools/packimg/genhead
tools/packimg/kfspad
tools/packimg/packbin
tools/packimg/rmhead
*.o

# Editor/OS cruft
*.swp
*~
.DS_Store

# Real credentials (provisioned into the image, never committed)
secrets/phoebus.env

# Runtime state created by the DHCP server, not source
rootfs/var/lib/misc/udhcpd.leases
net/.work/
net/staging/
