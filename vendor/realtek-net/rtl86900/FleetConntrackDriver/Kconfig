        default y 
        help
            ARM use one cpu port, reserved others for PE function.
endif
if FC_RTL8277C_SERIES
config RTK_FC_MAINCPU_ONE_CPU_PORT
        bool "ARM one cpu port for lan/wan rx"
        default y if RTK_FC_PKT_QUEUE_OFFLOAD_BY_PE||RTK_FC_HTTP_OFFLOAD_BY_PE||RTK_FC_CRYPTO_OFFLOAD_BY_PE||RTK_FC_SRV6_OFFLOAD_BY_PE
        depends on !RTK_VOIP || !RTK_VOIP_COPROCESS_DSP
        help
            ARM use one cpu port, reserved others for PE function.
endif

endif # RTK_L34_G3_PLATFORM

    
