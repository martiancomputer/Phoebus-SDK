config RTK_FC_ETHPORT_TRUNKING_BY_ONE_LUT
        bool "two lan ports or two wan ports trunking by one lut"
        depends on RTL8198X_SERIES
        select RTK_FC_ETHPORT_TRUNKING
        default n

config RTK_FC_WIFI_MULTIBAND_ACC_BY_ONE_LUT
	bool "wlan0 and wlan1 trunking by one lut"
	depends on RTL8198X_SERIES
	select RTK_FC_WIFI_MULTIBAND_ACC
	default n
endmenu

config RTK_FC_WIFI_DO_FLOW_OPERATION
