	depends on (FC_RTL8277C_SERIES || FC_RTL9607F_SERIES) && RTK_FC_WFO_PER_HW_FLOW_MIB
	default n

config RTK_FC_WFO_INTEGRATE_QOS
	bool "FC integrate wifi QoS before AMSDU PE offload"
	depends on (FC_RTL8277C_SERIES || FC_RTL9607F_SERIES) && RTK_FC_MAINCPU_ONE_CPU_PORT
	default n

