	depends on FC_CA8277B_SERIES
	default n


config RTK_FC_MEMLEAK_DEBUG
	bool "memory leak debug for FC driver"
	default n

config RTK_FC_FORWARDING_DROP
	bool "FC driver support forwarding drop"
	default n
	depends on RTK_L34_G3_PLATFORM

config RTK_FC_FORWARDING_DROP_PORT_IDX
	int "FC driver take specific port for drop"
	default 5
	depends on RTK_FC_FORWARDING_DROP
	help
		Must configure not used port number.

config RTK_FC_FORWARDING_AWARE_LAN_SWID
	bool "FC driver support swid in lan port forwarding"
	default n
	depends on RTK_L34_G3_PLATFORM
	help
		Flow entry aware swid and keep information in RXINFO_CPU_EXTSPA.

config RTK_FC_PTOOL_CPU_PERF
	bool "Enable ptool to measure cpu cycle"
	depends on RTK_PTOOL_CPU_PERF
	default n

config RTK_FC_RSV_ACL_HIGHER_PRI_VALUE
        int "reserve acl higher priority default value"
        range 0 7
        default 7

config RTK_FC_DRV_EVENT_RECORD_VERSION
	int "FC driver event record with different version"
	default 0
	help
		Default 0 is disable. 1 is reserve to FC, 2 is for CMDC.


config RTK_FC_SW_ACK_DELAY_WIDTH
	int "FC driver software ack delay witdh"
	default 0
	help
		Default 0 is disable, if enable, value should > 5. Example: value 16 is 32K sw entry and use 2K hash list.

config RTK_FC_TESTING
	bool "FC internal testing module"
	default n
	help
	   For test FC driver behavior

