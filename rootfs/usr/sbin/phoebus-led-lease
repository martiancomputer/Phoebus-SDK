#!/bin/sh
# udhcpd notify_file hook: recognize new/renewed ACKs and attribute by bridge FDB.
# A normal periodic lease-file rewrite must not masquerade as a DHCP ACK.
set -eu
STATE=/run/phoebus-leds
mkdir -p "$STATE"
chmod 700 "$STATE"
mkdir "$STATE/lease-lock" 2>/dev/null || exit 0
trap 'rmdir "$STATE/lease-lock"' EXIT
[ -r "${1:-}" ] || exit 0
od -An -v -tu1 "$1" | awk '
{for(i=1;i<=NF;i++) a[n++]=$i}
END {
 if(n<8 || (n-8)%36) exit 1
 written=0; for(i=0;i<8;i++) written=written*256+a[i]
 for(i=8;i+35<n;i+=36) {
  expires=((a[i]*256+a[i+1])*256+a[i+2])*256+a[i+3]
  if(!expires) continue
  printf "%02x:%02x:%02x:%02x:%02x:%02x %.0f\n",a[i+8],a[i+9],a[i+10],a[i+11],a[i+12],a[i+13],written+expires
 }
}' > "$STATE/leases.new"
[ -f "$STATE/leases.old" ] || : > "$STATE/leases.old"
awk 'FILENAME==ARGV[1] {old[$1]=$2;next} !($1 in old) || $2 > old[$1]+2 {print $1}' \
	"$STATE/leases.old" "$STATE/leases.new" > "$STATE/leases.changed"
brctl showmacs br0 > "$STATE/fdb" 2>/dev/null || exit 0
now=$(cut -d. -f1 /proc/uptime)
while read -r mac; do
	bridge_port=$(awk -v mac="$mac" 'tolower($2)==mac && $3=="no" {print $1;exit}' "$STATE/fdb")
	[ -n "$bridge_port" ] || continue
	port=1
	while [ "$port" -le 4 ]; do
		file="/sys/class/net/br0/brif/eth0.$((port + 1))/port_no"
		if [ -r "$file" ] && [ "$(($(cat "$file")))" -eq "$bridge_port" ]; then
			echo "$now" > "$STATE/lease-$port.tmp"
			mv "$STATE/lease-$port.tmp" "$STATE/lease-$port"
			break
		fi
		port=$((port + 1))
	done
done < "$STATE/leases.changed"
mv "$STATE/leases.new" "$STATE/leases.old"
