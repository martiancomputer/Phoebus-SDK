#!/bin/sh
# Independent board-status workers. All state is in RAM; no NAND access.
set -u
STATE=/run/phoebus-leds
SELF=/usr/sbin/phoebus-leds
LEDS=/sys/class/leds
mkdir -p "$STATE"
chmod 700 "$STATE"

led() {
	[ -w "$LEDS/$1/brightness" ] || return 0
	[ "$(cat "$LEDS/$1/brightness")" = "$2" ] || echo "$2" > "$LEDS/$1/brightness"
}
carrier() { [ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null)" = 1 ]; }
on() { led "$1" 255; }
off() { led "$1" 0; }

radio() {
	while :; do
		if timeout 2 hostapd_cli -i "$1" status 2>/dev/null | grep -qx 'state=ENABLED'; then
			on "$2"; sleep 1
		else
			on "$2"; sleep 0.35; off "$2"; sleep 0.35
		fi
	done
}

wan_probe() {
	while :; do
		iface=$(cat /run/wan_iface 2>/dev/null || :)
		case "$iface" in ''|*[!a-zA-Z0-9_.-]*) sleep 2; continue;; esac
		if carrier "$iface" && [ -s "$STATE/wan-lease" ] &&
		   [ "$(cat "$STATE/wan-lease")" = "$iface" ] &&
		   ping -I "$iface" -c 1 -W 1 1.1.1.1 >/dev/null 2>&1; then
			echo "$iface" > "$STATE/wan-online.tmp"
			mv "$STATE/wan-online.tmp" "$STATE/wan-online"
		else
			rm -f "$STATE/wan-online"
		fi
		sleep 3
	done
}

wan() {
	while :; do
		iface=$(cat /run/wan_iface 2>/dev/null || :)
		if [ -n "$iface" ] && carrier "$iface"; then
			if [ "$(cat "$STATE/wan-online" 2>/dev/null)" = "$iface" ]; then
				off internetorange; on internetgreen; sleep 0.3
			else
				off internetgreen; on internetorange; sleep 0.3
				off internetorange; sleep 0.3
			fi
		else
			off internetgreen; off internetorange; sleep 0.3
		fi
	done
}

lan() {
	previous=0; selected=0; ticks=0; lease_seen=0; announced=0
	while :; do
		mask=0; port=1
		while [ "$port" -le 4 ]; do
			bit=$((1 << (port - 1)))
			if carrier "eth0.$((port + 1))"; then
				mask=$((mask | bit))
				if [ $((previous & bit)) -eq 0 ]; then
					selected=$port; ticks=$((port * 2)); announced=0
					# ACKs observed since the previous poll also count.
					lease_seen=$(cat "$STATE/lease-$port" 2>/dev/null || echo 0)
					now=$(cut -d. -f1 /proc/uptime)
					[ "$lease_seen" -ge $((now - 1)) ] && lease_seen=0
				fi
			fi
			port=$((port + 1))
		done
		previous=$mask
		if [ "$selected" -ne 0 ] && [ $((mask & (1 << (selected - 1)))) -eq 0 ]; then
			selected=0; ticks=0; announced=0
		fi
		if [ "$mask" -eq 0 ]; then
			off lan
		elif [ "$ticks" -gt 0 ]; then
			if [ $((ticks % 2)) -eq 0 ]; then on lan; else off lan; fi
			ticks=$((ticks - 1))
			[ "$ticks" -eq 0 ] && ticks=-8 # steady for one second
		elif [ "$ticks" -lt 0 ]; then
			on lan; ticks=$((ticks + 1))
		elif [ "$selected" -ne 0 ] && [ "$announced" -eq 0 ] &&
		     [ "$(cat "$STATE/lease-$selected" 2>/dev/null || echo 0)" -gt "$lease_seen" ]; then
			off lan; sleep 0.08; on lan; announced=1
		else
			on lan
		fi
		sleep 0.125
	done
}

vpn() {
	while :; do
		connected=0
		if [ -S /run/tailscale/tailscaled.sock ] && [ -x /run/tailscale/tailscale ]; then
			timeout 3 /run/tailscale/tailscale --socket=/run/tailscale/tailscaled.sock status --json 2>/dev/null |
				grep -q '"BackendState": *"Running"' && connected=1
		fi
		# A configured WireGuard interface alone is not a working VPN.
		if command -v wg >/dev/null 2>&1; then
			now=$(date +%s)
			wg show all latest-handshakes 2>/dev/null |
				awk -v now="$now" '$3 > 0 && now >= $3 && now-$3 < 180 {ok=1} END {exit !ok}' && connected=1
		fi
		if [ "$connected" -eq 1 ]; then on wps; else off wps; fi
		sleep 5
	done
}

case "${1:-}" in
	radio) radio "$2" "$3";;
	wan-probe) wan_probe;;
	wan) wan;;
	lan) lan;;
	vpn) vpn;;
	'')
		# A singleton supervisor owns the seven LEDs. Children die on shutdown.
		mkdir "$STATE/lock" 2>/dev/null || exit 1
		children=''
		cleanup() {
			trap - EXIT INT TERM
			[ -z "$children" ] || kill $children 2>/dev/null
			wait 2>/dev/null
			rmdir "$STATE/lock" 2>/dev/null
		}
		trap cleanup EXIT
		trap 'exit 0' INT TERM
		# The kernel owns the initial flash/off/power blink. Do not race it.
		for ready in /sys/bus/platform/devices/boot-leds/userspace_ready; do
			if [ -w "$ready" ]; then
				echo 1 > "$ready"
				while [ "$(cat "${ready%/*}/phase")" != 3 ]; do sleep 0.1; done
			fi
		done
		for name in power wlan2g wlan5g lan internetgreen internetorange wps; do
			[ ! -w "$LEDS/$name/trigger" ] || echo none > "$LEDS/$name/trigger"
		done
		on power
		"$SELF" radio wlan0 wlan5g & children="$children $!"
		"$SELF" radio wlan1 wlan2g & children="$children $!"
		"$SELF" wan-probe & children="$children $!"
		"$SELF" wan & children="$children $!"
		"$SELF" lan & children="$children $!"
		"$SELF" vpn & children="$children $!"
		while :; do
			for child in $children; do kill -0 "$child" 2>/dev/null || exit 1; done
			sleep 3
		done
		;;
	*) exit 2;;
esac
