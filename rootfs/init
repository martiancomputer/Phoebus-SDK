#!/bin/sh
#
# Phoebus-OS stage 1 (PID 1 bootstrap)
# --------------------------------------------------------------------------
# The kernel execs this as /init. We mount the essential virtual filesystems,
# run the one-time bring-up, then exec s6-svscan so the s6 supervision tree
# takes over as PID 1 for the rest of the system's lifetime.
#
# Kept intentionally minimal and defensive: if s6-svscan can't start we drop
# to a rescue shell rather than leaving the board with a dead PID 1.
# --------------------------------------------------------------------------
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

# --- essential virtual filesystems ---
mount -t proc     proc     /proc            2>/dev/null
mount -t sysfs    sysfs    /sys             2>/dev/null
mount -t devtmpfs devtmpfs /dev             2>/dev/null
mount -t tmpfs    tmpfs    /run             2>/dev/null
mount -t tmpfs    tmpfs    /tmp             2>/dev/null
mkdir -p /dev/pts /run/service /run/s6-rc /var/log
mount -t devpts   devpts   /dev/pts         2>/dev/null

hostname rtl9607c

# --- quiet the serial console ---
# The Realtek switch and WiFi drivers are relentlessly chatty at KERN_INFO/WARN
# ([FCMGR], RTW:, PHL:, halbb, ...). At the cmdline's loglevel=8 that firehose
# interleaves with the shell and cuts you off mid-command. Drop the CONSOLE
# threshold to errors-and-above; nothing is lost, it all still goes to the
# kernel ring buffer -- `dmesg` shows the full history, and `dmesg -n 8` turns
# the firehose back on live. Boot with `phoebus_verbose` to keep it from boot.
grep -q phoebus_verbose /proc/cmdline 2>/dev/null || dmesg -n 4

echo
echo "  Phoebus-OS  (RTL9607C)  Linux 6.18.39  --  s6 init"
echo

# --- compile the s6-rc service database (on-target; the tools are MIPS bins) ---
# Output to tmpfs; rc-bootstrap (in the scandir) loads it once s6-svscan is up.
if s6-rc-compile /run/s6-rc/compiled /etc/s6/source 2>&1; then
	echo "init: s6-rc database compiled"
else
	echo "init: WARNING s6-rc-compile failed (direct scandir services still run)"
fi

# --- assemble the live scandir (tmpfs) from the read-only service repo ---
# s6-supervise needs to create control fifos, so the scandir must be writable.
# Contains getty-console (direct, always up) + rc-bootstrap (loads s6-rc).
cp -a /etc/s6/sv/. /run/service/ 2>/dev/null

# --- hand PID 1 to s6-svscan (supervises /run/service forever) ---
echo "init: handing off to s6-svscan"
exec s6-svscan -t0 /run/service

# --- only reached if the exec above failed: never leave PID 1 dead ---
echo "init: FATAL - s6-svscan exec failed; dropping to rescue shell"
exec setsid -c /bin/sh -l 0<>/dev/console 1>&0 2>&0
