#!/bin/sh
#
# Phoebus-OS routing/NAT (s6-rc `nat` oneshot, after `wan`).
# Masquerade LAN (br0) out of the WAN port and run a conservative stateful
# firewall: forwarding is default-DROP, only LAN->WAN plus its return traffic is
# allowed, and unsolicited traffic from the WAN cannot reach the router itself.
# --------------------------------------------------------------------------
set -eu
. "${PHOEBUS_FIREWALL_COMMON:-/etc/s6/scripts/firewall-lock}"
WAN=${WAN_IFACE:-$(cat /run/wan_iface 2>/dev/null || true)}; [ -n "$WAN" ] || WAN=nas0
LAN=${LAN_IFACE:-br0}
SYSCTL_ROOT=${PHOEBUS_SYSCTL_ROOT:-/proc/sys}

echo 1 > "$SYSCTL_ROOT/net/ipv4/ip_forward"
# Do not accept routes/redirects handed to us from the WAN side.
echo 0 > "$SYSCTL_ROOT/net/ipv4/conf/all/accept_redirects"
echo 0 > "$SYSCTL_ROOT/net/ipv4/conf/all/accept_source_route"

# start clean (this oneshot may be re-run)
# Never expose management while the old INPUT rules are removed.
iptables -w 10 -P INPUT DROP
iptables -w 10 -F; iptables -w 10 -X
iptables -w 10 -t nat -F; iptables -w 10 -t nat -X
# Leave mangle intact: network-up already installed FC warmup bypass marks.

iptables -w 10 -P INPUT   DROP
iptables -w 10 -P FORWARD DROP
iptables -w 10 -P OUTPUT  ACCEPT

# --- INPUT: trust the LAN, keep the WAN out ---
# SSH checks must precede broad LAN/ESTABLISHED accepts.
/bin/sh "${PHOEBUS_SSH_POLICY:-/etc/s6/scripts/ssh-policy}"
iptables -w 10 -A INPUT -i lo -j ACCEPT
iptables -w 10 -A INPUT -i "$LAN" -j ACCEPT
iptables -w 10 -A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables -w 10 -A INPUT -p icmp --icmp-type echo-request -j ACCEPT
iptables -w 10 -A INPUT -i "$WAN" -j DROP

# --- FORWARD: LAN out, replies back ---
iptables -w 10 -A FORWARD -i "$LAN" -o "$WAN" -j ACCEPT
iptables -w 10 -A FORWARD -i "$WAN" -o "$LAN" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables -w 10 -A FORWARD -i "$LAN" -o "$LAN" -j ACCEPT

# --- NAT ---
iptables -w 10 -t nat -A POSTROUTING -o "$WAN" -j MASQUERADE

# PMTU is often broken over PPPoE/tunnelled uplinks; clamp so big TCP segments
# do not silently black-hole.
iptables -w 10 -t mangle -C FORWARD -o "$WAN" -p tcp --tcp-flags SYN,RST SYN \
	-j TCPMSS --clamp-mss-to-pmtu 2>/dev/null ||
iptables -w 10 -t mangle -A FORWARD -o "$WAN" -p tcp --tcp-flags SYN,RST SYN \
	-j TCPMSS --clamp-mss-to-pmtu

echo "nat: masquerading $LAN -> $WAN (forward policy DROP, stateful)"
