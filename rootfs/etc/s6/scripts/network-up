#!/bin/sh
#
# Phoebus-OS network bring-up (s6-rc `network` oneshot).
#
# LAN  = br0 : eth0 + wlan0 (5GHz) + wlan1 (2.4GHz).  hostapd adds the wlans
#        itself via bridge=br0 in its configs.  br0 holds 192.168.1.1/24.
# WAN  = a single port kept OUT of the bridge, addressed by DHCP (see the `wan`
#        service).  Per the vendor NIC table in re8686_rtl9607c.c the ports map:
#          eth0        CPU port          eth0.2-.7   LAN_PORT1..6
#          eth0.8/.9   SGMII0/SGMII1     nas0        WAN_PORT (RTL8686_WAN)
#        so nas0 is the designated WAN. Override on the kernel cmdline with
#        e.g. wan=eth0.2 if your WAN socket maps elsewhere on this board.
# --------------------------------------------------------------------------
LAN_IP=192.168.1.1
LAN_MASK=24

ip link set lo up 2>/dev/null

# Realtek FleetConntrack flow accelerator -- must be off for our topology.
#
# The 9607C's flow engine lives in the switch ASIC and only accelerates
# switch-port to switch-port paths (see "RTL9607C CPU NIC Application Note",
# rx_info.reason 1-63 NAT / 64 NAT-forward, fb_hash flow index). wlan0/wlan1 are
# PCIe devices whose frames never cross the switch fabric, so the engine has no
# way to describe them. Accelerating WiFi needs the rtl_wfo packet-engine path,
# and that is 9607F-only -- its firmware blobs are literally zephyr_07F_pe*.bin,
# and the headers it wants are Cortina CA82xx. Not this chip.
#
# Left enabled (mode 1, the default) it hooks the wlan0->br0 bridge path anyway,
# builds a garbage device stack, and silently kills every offloaded flow one
# second after data starts moving:
#   [FCMGR] stack full please check DEV_STACK_MAX[4] ... @devStackto_skb_fcIngressData
#   [FCMGR] devStacking[0]=51, devStacking[1]=112, devStacking[2]=113, devStacking[3]=218
# (those are supposed to be netdev indices). Symptom was association + 4-way +
# DHCP all succeeding, then ping/SSH dying a few packets in.
#
# Mode 4 is what was verified working on-board. Override with hwnat=N on the
# kernel cmdline: 0 = no acceleration, 2 = software only, 4 = also trap unknown
# multicast to CPU. Worth revisiting once there is a real WAN to measure, since
# this also gives up hardware NAT on the wired path.
HWNAT=""
for a in $(cat /proc/cmdline 2>/dev/null); do
	case "$a" in hwnat=*) HWNAT="${a#hwnat=}" ;; esac
done
[ -n "$HWNAT" ] || HWNAT=4
if [ -w /proc/fc/ctrl/hwnat ]; then
	echo "$HWNAT" > /proc/fc/ctrl/hwnat
	echo "network: flow accelerator mode $HWNAT (see /proc/fc/ctrl/hwnat)"
fi

MAC=""; WAN=""; WANMAC=""
for a in $(cat /proc/cmdline 2>/dev/null); do
	case "$a" in
		ethaddr=*) MAC="${a#ethaddr=}" ;;
		wan=*)     WAN="${a#wan=}" ;;
		wanmac=*)  WANMAC="${a#wanmac=}" ;;
	esac
done
[ -n "$WAN" ] || WAN=nas0
echo "$WAN" > /run/wan_iface

if [ -n "$MAC" ]; then
	for i in /sys/class/net/eth* /sys/class/net/nas*; do
		[ -e "$i" ] || continue
		ip link set dev "$(basename "$i")" address "$MAC" 2>/dev/null
	done
	echo "network: MAC provisioned $MAC"

	# Give the radios stable BSSIDs derived from ethaddr (+1 for wlan0, +2 for
	# wlan1). Both eFuses are blank, so without this each driver invents a
	# random MAC every boot -- "assign random MAC" -> 00:e0:4c:xx:xx:xx -- and
	# clients see a brand-new AP after every power cycle. That breaks saved
	# profiles, PMKSA caching and roaming decisions for no good reason.
	#
	# Must happen before the interfaces come up below and before hostapd starts
	# (it depends on this service), or the BSSID is already baked into beacons.
	#
	# Relabelling the netdev is sufficient -- both drivers build beacons from
	# dev->dev_addr, so the new address does reach the air. Confirmed on
	# hardware: a client associated to 98:ba:5f:96:1a:82 with
	# ethaddr=98:BA:5F:96:1A:80, i.e. the +2 this loop assigns to wlan1.
	base=${MAC%:*}; last=${MAC##*:}
	for idx in 0 1; do
		[ -e "/sys/class/net/wlan$idx" ] || continue
		w=$(printf '%s:%02X' "$base" "$(( (0x$last + 1 + idx) & 0xff ))")
		ip link set dev "wlan$idx" down 2>/dev/null
		if ip link set dev "wlan$idx" address "$w" 2>/dev/null; then
			echo "network: wlan$idx BSSID $w"
		else
			echo "network: wlan$idx BSSID unchanged (driver refused $w)"
		fi
	done
fi

# Optional MAC clone on the WAN interface only: wanmac=AA:BB:CC:DD:EE:FF
#
# ISPs commonly bind a session to whichever MAC made the DHCP request, so
# moving a connection from a directly-attached PC to a router looks like a new
# device and lands back on the sign-in portal. Presenting the previously
# authorised MAC on the WAN side is what every consumer router's "clone MAC"
# button does, and it is the reason the button exists.
#
# Deliberately applied AFTER the ethaddr loop and AFTER the BSSID derivation
# above, and only to $WAN. Setting ethaddr= to the cloned address instead would
# also relabel br0 and shift both radios' BSSIDs (+1/+2), so every client would
# see a new AP and drop its saved profile -- a large blast radius for what
# should be a change to one interface.
#
# Must happen before the interface is brought up below: udhcpc has to send its
# DISCOVER from the cloned address, or the lease binds to the wrong one.
if [ -n "$WANMAC" ]; then
	if [ -e "/sys/class/net/$WAN" ]; then
		ip link set dev "$WAN" down 2>/dev/null
		if ip link set dev "$WAN" address "$WANMAC" 2>/dev/null; then
			echo "network: WAN $WAN MAC cloned to $WANMAC"
		else
			echo "network: WAN $WAN refused MAC $WANMAC (keeping $MAC)"
		fi
	else
		echo "network: wanmac= set but $WAN does not exist"
	fi
fi

for i in /sys/class/net/*; do
	dev=$(basename "$i")
	case "$dev" in lo|br0) continue ;; esac
	ip link set "$dev" up 2>/dev/null
done

# LAN bridge.
#
# Do NOT bridge raw eth0. It is the switch's CPU port, so bridging it builds an
# L2 loop: the switch floods frames the CPU just sent straight back up to it,
# br0 relearns its own MAC on a port, and forwarding blackholes. Symptoms were
# "br0: received packet on eth0 with own address as source address" spamming the
# console, and every WiFi client being deauthed ~50ms after it associated (even
# on an open SSID). Bridge the per-port VLAN netdevs instead -- each is its own
# broadcast domain, so there is no echo path back to the CPU port.
#
# Port map (vendor re8686_rtl9607c.c):
#   eth0        CPU port       eth0.2-.7  LAN_PORT1..6
#   eth0.8/.9   SGMII0/SGMII1  nas0       WAN_PORT
# Override the member list with lan=<if>[,<if>...] on the kernel cmdline; the
# carrier report below tells you which socket your cable is actually in.
LAN_PORTS=""
for a in $(cat /proc/cmdline 2>/dev/null); do
	case "$a" in lan=*) LAN_PORTS=$(echo "${a#lan=}" | tr ',' ' ') ;; esac
done
[ -n "$LAN_PORTS" ] || LAN_PORTS="eth0.2 eth0.3 eth0.4 eth0.5 eth0.6 eth0.7"

brctl addbr br0 2>/dev/null
bridged=""
for p in $LAN_PORTS; do
	[ -e "/sys/class/net/$p" ] || continue
	brctl addif br0 "$p" 2>/dev/null && bridged="$bridged $p"
done
[ -n "$MAC" ] && ip link set dev br0 address "$MAC" 2>/dev/null
ip link set br0 up 2>/dev/null
ip addr add "$LAN_IP/$LAN_MASK" dev br0 2>/dev/null
echo "network: br0 $LAN_IP/$LAN_MASK (wired:${bridged:- none} + wlan0 + wlan1)"
echo "network: WAN is $WAN"

# Carrier report -- makes it obvious which socket the cable is actually in,
# so picking the right wan= is a one-look job rather than guesswork.
for i in /sys/class/net/eth0.* /sys/class/net/nas*; do
	[ -e "$i/carrier" ] || continue
	c=$(cat "$i/carrier" 2>/dev/null)
	[ "$c" = "1" ] && echo "network:   carrier UP on $(basename "$i")"
done

# The carrier loop's final `[ "$c" = "1" ]` test leaks its status as the script's
# exit code; a socket with no cable makes it 1, and s6-rc reads a nonzero return
# from a oneshot as service failure (which aborts the whole bundle). Bring-up
# already succeeded above, so end explicitly on success.
exit 0
