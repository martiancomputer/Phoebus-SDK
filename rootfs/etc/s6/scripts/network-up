#!/bin/sh
#
# Phoebus-OS network bring-up (s6-rc `network` oneshot).
#
# LAN  = br0 : eth0 + wlan0 (5GHz) + wlan1 (2.4GHz).  hostapd adds the wlans
#        itself via bridge=br0 in its configs.  br0 holds 192.168.1.1/24.
# WAN  = a single port kept OUT of the bridge, addressed by DHCP (see the `wan`
#        service).  Per the vendor NIC table in re8686_rtl9607c.c the ports map:
#          eth0        CPU port          eth0.2-.7   LAN_PORT1..6
#          eth0.8/.9   SGMII0/SGMII1     nas0        WAN_PORT (RTL8686_WAN)
#        so nas0 is the designated WAN. Override on the kernel cmdline with
#        e.g. wan=eth0.2 if your WAN socket maps elsewhere on this board.
# --------------------------------------------------------------------------
LAN_IP=192.168.1.1
LAN_MASK=24

ip link set lo up 2>/dev/null

MAC=""; WAN=""
for a in $(cat /proc/cmdline 2>/dev/null); do
	case "$a" in
		ethaddr=*) MAC="${a#ethaddr=}" ;;
		wan=*)     WAN="${a#wan=}" ;;
	esac
done
[ -n "$WAN" ] || WAN=nas0
echo "$WAN" > /run/wan_iface

if [ -n "$MAC" ]; then
	for i in /sys/class/net/eth* /sys/class/net/nas*; do
		[ -e "$i" ] || continue
		ip link set dev "$(basename "$i")" address "$MAC" 2>/dev/null
	done
	echo "network: MAC provisioned $MAC"
fi

for i in /sys/class/net/*; do
	dev=$(basename "$i")
	case "$dev" in lo|br0) continue ;; esac
	ip link set "$dev" up 2>/dev/null
done

# LAN bridge -- everything except the WAN port
brctl addbr br0 2>/dev/null
brctl addif br0 eth0 2>/dev/null
[ -n "$MAC" ] && ip link set dev br0 address "$MAC" 2>/dev/null
ip link set br0 up 2>/dev/null
ip addr add "$LAN_IP/$LAN_MASK" dev br0 2>/dev/null
echo "network: br0 $LAN_IP/$LAN_MASK (LAN: eth0 + wlan0 + wlan1)"
echo "network: WAN is $WAN"

# Carrier report -- makes it obvious which socket the cable is actually in,
# so picking the right wan= is a one-look job rather than guesswork.
for i in /sys/class/net/eth0.* /sys/class/net/nas*; do
	[ -e "$i/carrier" ] || continue
	c=$(cat "$i/carrier" 2>/dev/null)
	[ "$c" = "1" ] && echo "network:   carrier UP on $(basename "$i")"
done
