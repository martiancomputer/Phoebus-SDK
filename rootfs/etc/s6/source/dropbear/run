#!/bin/sh
#
# Phoebus-OS SSH server (dropbear), supervised by s6.
#
# Host key: ECDSA (NIST P-256). dropbear 2019.78 supports RSA/DSS/ECDSA only --
# ed25519 arrived in 2020.79, so do NOT ask for it here: dropbearkey fails and
# dropbear then exits with "No hostkeys available" on every restart.
# Generated on first boot into /etc/dropbear. The rootfs is a RAM initramfs, so
# this regenerates every boot -- clients will see a changed host key across
# reboots until the board gets persistent storage.
#
# Login model: password auth against /etc/shadow for `admin` (uid 1000), plus
# key auth for whatever provision-secrets.sh installed.
#
# Root may log in BY KEY ONLY. dropbear runs with -g, which disables root
# password auth while leaving root pubkey auth working, so the root hash in
# /etc/shadow can never be used over the network. (-w, which was here before,
# blocks root entirely.)
#
# This exists for a concrete reason: the Realtek drivers' set_mib ioctls are
# root-only. admin can read every MIB but write none, so tuning the radio
# otherwise costs a full reflash per setting -- a slow loop on a problem with
# a lot of variables still open.
#
# Safe because nat-up drops all WAN input (-A INPUT -i $WAN -j DROP), so
# dropbear's 0.0.0.0:22 is reachable from the LAN only. If that rule is ever
# removed or the firewall stops loading, revisit this line FIRST.
#
# This is a development posture for a RAM-booted test image. A build destined
# for NAND should get fresh keys and its own decision about root access.
KEY=/etc/dropbear/dropbear_ecdsa_host_key

# Fix ownership of admin's home before starting.
#
# The initramfs is generated with every file owned by root, so an
# authorized_keys installed at build time by provision-secrets.sh lands as
# root:root -- and dropbear refuses a key file whose owner is not the user
# logging in. The failure is a flat "Permission denied (publickey,password)"
# with nothing logged about why, which reads as a missing or wrong key rather
# than a wrong uid. The keys were baked in correctly and simply never worked.
#
# Cheap and idempotent, so it runs on every service start and stays next to the
# thing that depends on it.
if [ -d /home/admin ]; then
	chown -R admin:admin /home/admin 2>/dev/null || true
	chmod 0700 /home/admin/.ssh 2>/dev/null || true
	chmod 0600 /home/admin/.ssh/authorized_keys 2>/dev/null || true
fi
# root's copy is already root-owned by virtue of the initramfs, but fix the
# modes: dropbear refuses a key file that is group- or world-writable.
if [ -d /root/.ssh ]; then
	chmod 0700 /root/.ssh 2>/dev/null || true
	chmod 0600 /root/.ssh/authorized_keys 2>/dev/null || true
fi

mkdir -p /etc/dropbear
if [ ! -s "$KEY" ]; then
	# Do not silence this: if keygen fails, its error is the only clue as to why
	# SSH never comes up.
	dropbearkey -t ecdsa -s 256 -f "$KEY" || echo "dropbear: ECDSA keygen FAILED"
fi

# Never hot-loop the console. Without a key dropbear exits immediately, and an
# unthrottled s6 restart floods the serial log (~4/sec) and buries real output.
if [ ! -s "$KEY" ]; then
	echo "dropbear: no host key at $KEY; retrying in 15s"
	sleep 15
	exit 1
fi

# -F foreground (s6 supervises)   -E log to stderr (s6 catches it)
# -g no root PASSWORD login       -p 22
#    (root pubkey auth still works; -w would block root outright)
exec dropbear -F -E -g -p 22 -r "$KEY"
